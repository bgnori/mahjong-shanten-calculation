{
  "name": "shanten-dev",
  "build": {
    "dockerfile": "dev/Dockerfile",
    "context": ".."
  },
  "runArgs": ["--cpus=2", "--memory=16g"],
  "mounts": [
    "source=${localEnv:HOME}/.cache/mathlib,target=/home/vscode/.cache/mathlib,type=bind"
  ],
  "containerEnv": {
    "MATHLIB_CACHE_DIR": "/home/vscode/.cache/mathlib",
    "MATHLIB_NO_CACHE_ON_UPDATE": "1",
    "LEAN_NUM_THREADS": "2"
  },
  "postCreateCommand": "lake update && lake exe cache get $(find Shanten -name '*.lean' -exec sed -n 's/^import \\(Mathlib\\..*\\)$/\\1/p' {} + | sort -u)",
  "customizations": {
    "vscode": {
      "extensions": ["golang.go", "leanprover.lean4"]
    }
  }
}
